# MySQL — scripts de escrita (clean-data --apply): nome DEVE terminar em _teste ou _test
# Production (Vercel): banco NOVO sem sufixo (ex. prestadores_v2) — ver docs/RUNBOOK-VIRADA.md
# Preview PR #9: apontar para *_teste já migrado — ver docs/VARIAVEIS-AMBIENTE.md
DATABASE_URL="mysql://usuario:senha@localhost:3306/catalogo_servicos_teste"

# Hosts de produção (denylist — segunda camada)
PRODUCTION_DATABASE_HOSTS="mysql.sindicone.com.br"

# Obrigatória — mínimo 32 caracteres. Sem fallback no código.
JWT_SECRET="substitua_por_chave_aleatoria_com_pelo_menos_32_chars"

# URL pública do site
NEXT_PUBLIC_APP_URL="https://sindicone.com.br"

# Ativar Prisma/MySQL real
USE_REAL_PRISMA="true"

# Seed do admin (obrigatórios para npm run db:seed)
ADMIN_EMAIL="admin@seudominio.com"
ADMIN_PASSWORD="senha_forte_minimo_12_chars"
ADMIN_NAME="Administrador"
