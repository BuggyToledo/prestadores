# Conexão com o Banco de Dados MySQL de Produção
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://usuario:senha@localhost:3306/catalogo_servicos"

# Chave secreta para autenticação JWT (utilizada para o painel administrativo)
JWT_SECRET="chave_secreta_padrao_catalogo_servicos_super_segura_2025"

# URL pública do site (seu domínio próprio com https)
NEXT_PUBLIC_APP_URL="https://sindicone.com.br"

# Ativar conexão com o MySQL real via Prisma (defina como "true" em produção)
USE_REAL_PRISMA="true"
