generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum BannerPosition {
  HERO_TOP
  MIDDLE
  SIDEBAR
  FOOTER
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("users")
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  description   String?       @db.Text
  icon          String?       @default("Briefcase")
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  providers     Provider[]
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  order       Int        @default(0)
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providers   Provider[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([categoryId])
  @@map("subcategories")
}

model Provider {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  cnpj         String?
  phone        String?
  whatsapp     String?
  email        String?
  website      String?
  instagram    String?
  
  // Endereço
  address      String?
  neighborhood String?
  city         String
  state        String
  zipCode      String?
  
  // Detalhes
  description  String?  @db.Text
  services     String?  @db.Text
  logoUrl      String?  @db.Text
  coverUrl     String?  @db.Text
  
  // Status
  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  viewsCount   Int      @default(0)
  
  // Relacionamento com Categoria e Subcategoria
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([city, state])
  @@index([isActive])
  @@map("providers")
}

model Banner {
  id          String         @id @default(uuid())
  title       String         // Nome do anunciante / campanha
  imageUrl    String         @db.LongText // URL ou imagem base64
  linkUrl     String?        @db.Text // Link ao clicar (site, WhatsApp, etc)
  target      String         @default("_blank") // _blank ou _self
  position    BannerPosition @default(HERO_TOP)
  isActive    Boolean        @default(true)
  order       Int            @default(0)
  clicksCount Int            @default(0)
  viewsCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([position, isActive])
  @@map("banners")
}
