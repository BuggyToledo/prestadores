generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum BannerPosition {
  HERO_TOP
  MIDDLE
  SIDEBAR
  FOOTER
}

enum ProviderKind {
  prestador
  utilidade_publica
}

enum TrustTier {
  cadastrado
  documentado
  oficial
}

model User {
  id                 String    @id @default(uuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               Role      @default(ADMIN)
  /// Incrementado a cada troca de senha — invalida JWTs antigos
  sessionVersion     Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  auditLogs          AuditLog[]

  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?  @db.Text
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Category {
  id            String        @id @default(uuid())
  name          String        @unique
  slug          String        @unique
  description   String?       @db.Text
  icon          String?       @default("Briefcase")
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  providers     Provider[]
  subcategories Subcategory[]

  @@map("categories")
}

model Subcategory {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  order       Int        @default(0)
  categoryId  String
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  providers   Provider[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([categoryId])
  @@map("subcategories")
}

model Provider {
  id           String   @id @default(uuid())
  name         String
  /// Nome para exibição (Title Case normalizado)
  displayName  String?
  slug         String   @unique
  cnpj         String?
  phone        String?
  whatsapp     String?
  email        String?
  website      String?  @db.Text
  instagram    String?  @db.Text

  address      String?  @db.Text
  neighborhood String?
  city         String
  state        String
  zipCode      String?

  description  String?  @db.Text
  services     String?  @db.Text
  logoUrl      String?  @db.Text
  coverUrl     String?  @db.Text

  isFeatured   Boolean  @default(false)
  isActive     Boolean  @default(true)
  viewsCount   Int      @default(0)

  kind         ProviderKind @default(prestador)
  trustTier    TrustTier    @default(cadastrado)
  serves24h    Boolean      @default(false)
  issuesNfe    Boolean      @default(false)
  acceptsInvoicingTerms Boolean @default(false)
  /// Fila de revisão manual (JSON com motivos)
  needsReview  Boolean      @default(false)
  reviewNotes  String?      @db.Text

  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId String?
  subcategory   Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([city, state])
  @@index([isActive])
  @@index([kind])
  @@index([trustTier])
  @@index([needsReview])
  @@map("providers")
}

model Banner {
  id          String         @id @default(uuid())
  title       String
  imageUrl    String         @db.LongText
  linkUrl     String?        @db.Text
  target      String         @default("_blank")
  position    BannerPosition @default(HERO_TOP)
  isActive    Boolean        @default(true)
  order       Int            @default(0)
  clicksCount Int            @default(0)
  viewsCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([position, isActive])
  @@map("banners")
}
